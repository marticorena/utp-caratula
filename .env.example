# Host path containing licensed Calibri, Arial, Times New Roman and Georgia fonts.
# The default in compose.yaml already points to the Windows Fonts directory.
CALIBRI_FONT_DIR=C:/Windows/Fonts

# Host port exposed by Docker Compose.
PORT=8000

# Hosting: Neon pooled PostgreSQL URL (keep sslmode=require).
# Leave empty locally to continue using SQLite.
DATABASE_URL=
# Set to 1 on Render so missing database configuration fails at startup.
REQUIRE_DATABASE_URL=0
# native = licensed Windows fonts; portable = bundled open-source fonts.
FONT_MODE=native
